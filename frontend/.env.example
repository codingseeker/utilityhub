# UtilityHub frontend — Vite environment
# Copy to .env.local for local development.

# Base URL of the Cloud Run API. Keep /api/v1 when Firebase Hosting rewrites
# /api/** to the API service. Use an absolute URL for a separate deployment.
VITE_API_BASE_URL=/api/v1

# dev | firebase. Defaults to dev only when running the Vite dev server.
# Production builds require Firebase configuration below.
VITE_AUTH_MODE=dev

# Firebase Web App configuration (Project settings → Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
