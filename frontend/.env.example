# Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the project's Legacy anon key (JWT beginning with eyJ), not an sb_publishable_ key.
VITE_SUPABASE_ANON_KEY=eyJ...

# Optional. Defaults to $VITE_SUPABASE_URL/functions/v1/api when omitted.
# VITE_API_BASE_URL=https://your-project-ref.supabase.co/functions/v1/api
