# ---------------------------------------------------------------------------
# UtilityHub API / worker — local development configuration
# Copy to .env. Local mode uses in-memory metadata and a local object folder.
# Production refuses these values; see docs/GCP_DEPLOYMENT.md.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false

# --- Adapters -------------------------------------------------------------
# local | gcs
STORAGE_DRIVER=local
# memory | firestore
DB_DRIVER=memory
# dev | firebase
AUTH_MODE=dev
STORAGE_ROOT=var/objects

# --- Google Cloud (required when the gcs/firestore/firebase adapters run) --
GCP_PROJECT_ID=utilityhub-local
GCS_BUCKET=utilityhub-local
FIRESTORE_DATABASE_ID=(default)

# Local-only HMAC secret for /api/v1/dev-storage signed URLs.
SIGNED_URL_SECRET=local-development-signing-secret-change-me

# Dev identity used when AUTH_MODE=dev. Requests must also send
# X-Dev-User: <uid>; there is no silent fallback in production.
DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@utilityhub.local
DEV_USER_NAME=Dev User

# Optional Firebase Auth emulator, e.g. localhost:9099
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- Worker ---------------------------------------------------------------
# Cloud Run worker URL; leave empty for the local polling worker.
# WORKER_URL=https://utilityhub-worker-xxxxx-uc.a.run.app
# Shared secret is optional defense-in-depth on top of OIDC.
# WORKER_SHARED_SECRET=
WORKER_POLL=true
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=90
WORKER_HEARTBEAT_SECONDS=30
WORKER_MAX_ATTEMPTS=2
WORKER_POLL_INTERVAL_MS=2000
WORKER_RUN_BUDGET_MS=480000

# --- Retention ------------------------------------------------------------
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300
UPLOAD_RETENTION_HOURS=6
RESULT_RETENTION_HOURS=24
METADATA_RETENTION_HOURS=72

# --- Limits ---------------------------------------------------------------
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_JOB=20
MAX_JOB_INPUT_MB=100
MAX_PDF_PAGES=500
MAX_MERGED_PAGES=2000
MAX_SPLIT_PARTS=20
PDF_TO_IMAGES_MAX_PAGES=100
MAX_IMAGE_MEGAPIXELS=40
PDF_TO_IMAGES_MAX_PIXELS=50000000
MAX_TEXT_BYTES=1048576
MAX_CSV_ROWS=20000

# --- Quota / rate limiting ------------------------------------------------
QUOTA_JOBS_PER_DAY=50
QUOTA_BYTES_PER_DAY_MB=500
MAX_ACTIVE_JOBS=3
RATE_LIMIT_ENABLED=true

# --- Processing timeouts (milliseconds) -----------------------------------
MERGE_TIMEOUT_MS=120000
SPLIT_TIMEOUT_MS=120000
COMPRESS_TIMEOUT_MS=180000
ROTATE_TIMEOUT_MS=90000
IMAGES_TO_PDF_TIMEOUT_MS=180000
PDF_TO_IMAGES_TIMEOUT_MS=300000
IMAGE_TIMEOUT_MS=60000
DATA_TIMEOUT_MS=60000
TEXT_TIMEOUT_MS=30000
