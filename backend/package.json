{
  "name": "utilityhub-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "worker:poll": "node src/worker.js --poll",
    "worker:once": "node src/worker.js --once",
    "cleanup": "node src/worker.js --cleanup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.4.1",
    "@google-cloud/storage": "9.0.0",
    "archiver": "8.0.0",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "firebase-admin": "14.5.1",
    "google-auth-library": "10.7.0",
    "helmet": "8.3.0",
    "papaparse": "5.7.1",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "minimatch": "11.0.9"
  }
}
